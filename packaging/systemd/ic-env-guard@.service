[Unit]
Description=IC Design Environment Guard Agent (%i)
Documentation=file:/usr/share/doc/ic-env-guard/guides/agent-deployment.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=~
RuntimeDirectory=ic-env-guard
RuntimeDirectoryMode=0700
EnvironmentFile=-/etc/ic-env-guard/%i.env
Environment=IC_ENV_GUARD_CONFIG=/etc/ic-env-guard/%i.yaml
ExecStart=/usr/local/bin/ic-env-guard --config /etc/ic-env-guard/%i.yaml
ExecReload=/usr/local/bin/ic-env-guard-config validate /etc/ic-env-guard/%i.yaml
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
